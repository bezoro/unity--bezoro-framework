# Normalize text files by default.
* text=auto eol=lf

# Platform-specific scripts.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf
*.sh text eol=lf
*.bash text eol=lf
*.zsh text eol=lf
# Source and config files.
*.cs text diff=csharp
*.csx text diff=csharp
*.asmdef text
*.asmref text
*.cginc text
*.compute text
*.hlsl text
*.shader text
*.shadergraph text
*.shadersubgraph text
*.uxml text
*.uss text
*.json text
*.jsonc text
*.md text
*.rsp text
*.txt text
*.xml text
*.yaml text
*.yml text
*.csv text
*.tsv text
.gitignore text eol=lf
.gitattributes text eol=lf
.editorconfig text eol=lf
# Unity YAML assets.
# These Smart Merge rules require a local `unityyamlmerge` merge driver setup.
*.meta text merge=unityyamlmerge
*.unity text merge=unityyamlmerge
*.prefab text merge=unityyamlmerge
*.asset text merge=unityyamlmerge
*.anim text merge=unityyamlmerge
*.controller text merge=unityyamlmerge
*.mat text merge=unityyamlmerge
*.mask text merge=unityyamlmerge
*.overrideController text merge=unityyamlmerge
*.physicsMaterial2D text merge=unityyamlmerge
*.physicMaterial text merge=unityyamlmerge
*.playable text merge=unityyamlmerge
*.preset text merge=unityyamlmerge
*.renderTexture text merge=unityyamlmerge
*.spriteatlas text merge=unityyamlmerge
*.terrainlayer text merge=unityyamlmerge
*.inputactions text merge=unityyamlmerge
*.vfx text merge=unityyamlmerge
